    Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
)


# ── Link rendering helpers ────────────────────────────────────────────────────


def _link_icon_and_label(lnk: dict) -> tuple[str, str]:
    """Return (icon_emoji, display_title) for a link."""
    if lnk["type"] == "ref":
        return "📋", lnk.get("text", "ref")
    elif lnk["type"] == "url":
        return "🌐", lnk.get("title") or lnk.get("url", "")[:30]
    else:
        return "🔗", lnk.get("title", "link")


def _make_link_button(lnk: dict) -> Gtk.Button:
    icon, raw_title = _link_icon_and_label(lnk)
    short = (raw_title[:20] + "…") if len(raw_title) > 20 else raw_title
    btn = Gtk.Button(label=f"{icon} {short}")
    btn.set_tooltip_text(raw_title)
    btn.set_relief(Gtk.ReliefStyle.NONE)
    btn.get_style_context().add_class("link-chit")
    btn.connect("clicked", lambda _b, l=lnk: open_link(l))
    return btn


# ── Detail Dialog ─────────────────────────────────────────────────────────────


class DetailDialog(Gtk.Dialog):
    """Shows full note details with view/edit modes."""

    def __init__(self, parent: Gtk.Window, note_id: str):
        self._note_id = note_id
        self._editing = False

        note = self._load_note()
        if not note:
            super().__init__(title="Not Found", transient_for=parent, modal=True)
            self.get_content_area().pack_start(
                Gtk.Label(label="Note not found."), True, True, 20
            )
            self.add_button(Gtk.STOCK_CLOSE, Gtk.ResponseType.CLOSE)
            self.show_all()
            return

        super().__init__(
            title=f"HotNote — {note['summary'][:40]}",
            transient_for=parent,
            modal=True,
            destroy_with_parent=True,
        )
        self.set_default_size(560, 480)
        self.get_style_context().add_class("hotnote-window")

        self._content = self.get_content_area()
        self._content.set_spacing(0)
        self._build_view(note)
        self.show_all()

    def _load_note(self) -> dict | None:
        notes = load_notes()
        for n in notes:
            if n["id"] == self._note_id:
                return n
        return None

    def _save_note(self, note: dict) -> None:
        notes = load_notes()
        for i, n in enumerate(notes):
            if n["id"] == self._note_id:
                notes[i] = note
                break
        save_notes(notes)

    def _clear_content(self) -> None:
        for child in self._content.get_children():
            self._content.remove(child)

    # ── View mode ─────────────────────────────────────────────────────────────

    def _build_view(self, note: dict) -> None:
        self._clear_content()

        header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        header.get_style_context().add_class("detail-header")
        header.set_border_width(0)
        self._content.pack_start(header, False, False, 0)

        summary_lbl = Gtk.Label()
        escaped = GLib.markup_escape_text(note["summary"])
        summary_lbl.set_markup(f'<span size="large" weight="bold">{escaped}</span>')
        summary_lbl.set_xalign(0)
        summary_lbl.set_line_wrap(True)
        summary_lbl.set_max_width_chars(60)
        summary_lbl.set_hexpand(True)
        header.pack_start(summary_lbl, True, True, 0)

        edit_btn = Gtk.Button(label="✏️ Edit")
        edit_btn.get_style_context().add_class("detail-edit-btn")
        edit_btn.set_relief(Gtk.ReliefStyle.NONE)
        edit_btn.connect("clicked", self._switch_to_edit)
        header.pack_end(edit_btn, False, False, 0)

        body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        body.set_border_width(16)
        self._content.pack_start(body, True, True, 0)

        # Metadata row
        meta_grid = Gtk.Grid()
        meta_grid.set_column_spacing(16)
        meta_grid.set_row_spacing(6)
        body.pack_start(meta_grid, False, False, 0)

        imp = note.get("importance", "medium")
        urg = note.get("urgency", "soon")
        meta_grid.attach(Gtk.Label(label="Importance:", xalign=0), 0, 0, 1, 1)
        meta_grid.attach(
            colored_label(imp, IMPORTANCE_COLORS.get(imp, "#ccc")), 1, 0, 1, 1
        )
        meta_grid.attach(Gtk.Label(label="Urgency:", xalign=0), 0, 1, 1, 1)
        meta_grid.attach(
            colored_label(urg, URGENCY_COLORS.get(urg, "#ccc")), 1, 1, 1, 1
        )
        meta_grid.attach(Gtk.Label(label="Created:", xalign=0), 0, 2, 1, 1)
        meta_grid.attach(
            Gtk.Label(label=note.get("created", "—")[:10], xalign=0), 1, 2, 1, 1
        )

        meta_row = 3
        appear = note.get("appear_date")
        if appear:
            appear_text = fmt_appear_short(note)
            meta_grid.attach(Gtk.Label(label="Appears:", xalign=0), 0, meta_row, 1, 1)
            meta_grid.attach(
                colored_label(appear_text, "#64b5f6"), 1, meta_row, 1, 1
            )
            meta_row += 1

        recur = note.get("recur")
        if recur:
            recur_text = fmt_recur_short(note)
            next_due = note.get("next_due", "")[:10]
            meta_grid.attach(
                Gtk.Label(label="Recurrence:", xalign=0), 0, meta_row, 1, 1
            )
            meta_grid.attach(
                Gtk.Label(label=f"{recur_text}  (next: {next_due})", xalign=0),
                1,
                meta_row,
                1,
                1,
            )
            meta_row += 1

        # Details/notes field
        details_text = note.get("details", "")
        if details_text:
            det_title = Gtk.Label()
            det_title.set_markup(
                '<span foreground="#ff6d00" weight="bold">Notes</span>'
            )
            det_title.set_xalign(0)
            body.pack_start(det_title, False, False, 0)

            det_lbl = Gtk.Label(label=details_text)
            det_lbl.set_xalign(0)
            det_lbl.set_line_wrap(True)
            det_lbl.set_selectable(True)
            body.pack_start(det_lbl, False, False, 0)

        # Links section
        links = note.get("links", [])
        link_title = Gtk.Label()
        link_title.set_markup(
            f'<span foreground="#ff6d00" weight="bold">Links ({len(links)})</span>'
        )
        link_title.set_xalign(0)
        body.pack_start(link_title, False, False, 0)

        if links:
            for lnk in links:
                row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
                row.get_style_context().add_class("detail-link-row")
                icon, title = _link_icon_and_label(lnk)
                btn = Gtk.Button(label=f"{icon} {title}")
                btn.set_relief(Gtk.ReliefStyle.NONE)
                btn.set_tooltip_text(lnk.get("url", lnk.get("text", "")))
                btn.connect("clicked", lambda _b, l=lnk: open_link(l))
                row.pack_start(btn, False, False, 0)
                body.pack_start(row, False, False, 0)
        else:
            body.pack_start(Gtk.Label(label="No links yet.", xalign=0), False, False, 0)

        # Close button at the bottom
        close_btn = Gtk.Button(label="Close")
        close_btn.connect("clicked", lambda _b: self.destroy())
        btn_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        btn_box.pack_end(close_btn, False, False, 0)
        body.pack_end(btn_box, False, False, 0)

        self._content.show_all()

    # ── Edit mode ─────────────────────────────────────────────────────────────

    def _switch_to_edit(self, _widget=None) -> None:
        note = self._load_note()
        if not note:
            return
        self._editing = True
        self._build_edit(note)

    def _build_edit(self, note: dict) -> None:
        self._clear_content()

        header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        header.get_style_context().add_class("detail-header")
        self._content.pack_start(header, False, False, 0)

        header_lbl = Gtk.Label()
        header_lbl.set_markup('<span size="large" weight="bold">✏️ Editing</span>')
        header_lbl.set_xalign(0)
        header_lbl.set_hexpand(True)
        header.pack_start(header_lbl, True, True, 0)

        body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        body.set_border_width(16)
        self._content.pack_start(body, True, True, 0)

        # Summary
        body.pack_start(Gtk.Label(label="Summary:", xalign=0), False, False, 0)
        self._edit_summary = Gtk.Entry()
        self._edit_summary.set_text(note.get("summary", ""))
        body.pack_start(self._edit_summary, False, False, 0)

        # Details (multiline)
        body.pack_start(Gtk.Label(label="Notes / details:", xalign=0), False, False, 0)
        scroll = Gtk.ScrolledWindow()
        scroll.set_min_content_height(80)
        scroll.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
        self._edit_details_buf = Gtk.TextBuffer()
        self._edit_details_buf.set_text(note.get("details", ""))
        details_view = Gtk.TextView(buffer=self._edit_details_buf)
        details_view.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
        scroll.add(details_view)
        body.pack_start(scroll, False, False, 0)

        # Importance / Urgency
        level_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        body.pack_start(level_box, False, False, 0)

        level_box.pack_start(Gtk.Label(label="Importance:"), False, False, 0)
        self._edit_imp = Gtk.ComboBoxText()
        for v in IMPORTANCE_VALUES:
            self._edit_imp.append_text(v)
        cur_imp = note.get("importance", "medium")
        self._edit_imp.set_active(
            IMPORTANCE_VALUES.index(cur_imp) if cur_imp in IMPORTANCE_VALUES else 2
        )
        level_box.pack_start(self._edit_imp, False, False, 0)

        level_box.pack_start(Gtk.Label(label="Urgency:"), False, False, 0)
        self._edit_urg = Gtk.ComboBoxText()
        for v in URGENCY_VALUES:
            self._edit_urg.append_text(v)
        cur_urg = note.get("urgency", "soon")
        self._edit_urg.set_active(
            URGENCY_VALUES.index(cur_urg) if cur_urg in URGENCY_VALUES else 1
        )
        level_box.pack_start(self._edit_urg, False, False, 0)

        sched_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        body.pack_start(sched_box, False, False, 0)

        sched_box.pack_start(Gtk.Label(label="Appear on:"), False, False, 0)
        self._edit_appear = Gtk.Entry()
        self._edit_appear.set_width_chars(12)
        self._edit_appear.set_placeholder_text("YYYY-MM-DD")
        self._edit_appear.set_tooltip_text(
            "Date this note becomes visible (leave empty for immediate)"
        )
        self._edit_appear.set_text(note.get("appear_date") or "")
        sched_box.pack_start(self._edit_appear, False, False, 0)

        edit_cal_btn = Gtk.Button(label="📅")
        edit_cal_btn.set_relief(Gtk.ReliefStyle.NONE)
        edit_cal_btn.set_tooltip_text("Pick date")
        edit_cal_btn.connect("clicked", self._on_pick_appear_cal)
        sched_box.pack_start(edit_cal_btn, False, False, 0)

        sched_box.pack_start(
            Gtk.Label(label="Repeat every:"), False, False, 8
        )
        self._edit_recur = Gtk.Entry()
        self._edit_recur.set_width_chars(8)
        self._edit_recur.set_placeholder_text("optional, e.g. 7d")
        self._edit_recur.set_tooltip_text(
            "18d, 2w, 1m — or leave empty for no recurrence"
        )
        cur_recur = note.get("recur")
        if cur_recur:
            short = {"days": "d", "weeks": "w", "months": "m"}[cur_recur["unit"]]
            self._edit_recur.set_text(f"{cur_recur['every']}{short}")
        sched_box.pack_start(self._edit_recur, False, False, 0)

        # Links section with CRUD
        link_header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        body.pack_start(link_header, False, False, 0)
        link_title = Gtk.Label()
        link_title.set_markup('<span foreground="#ff6d00" weight="bold">Links</span>')
        link_title.set_xalign(0)
        link_header.pack_start(link_title, False, False, 0)

        add_link_btn = Gtk.Button(label="+ Add link")
        add_link_btn.set_relief(Gtk.ReliefStyle.NONE)
        add_link_btn.connect("clicked", self._on_edit_add_link)
        link_header.pack_end(add_link_btn, False, False, 0)

        self._links_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        body.pack_start(self._links_box, False, False, 0)

        self._edit_links = list(note.get("links", []))
        self._rebuild_links_list()

        # Action buttons
        spacer = Gtk.Box()
        spacer.set_vexpand(True)
        body.pack_start(spacer, True, True, 0)

        btn_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        body.pack_end(btn_row, False, False, 0)

        cancel_btn = Gtk.Button(label="Cancel")
        cancel_btn.connect("clicked", self._on_edit_cancel)
        btn_row.pack_end(cancel_btn, False, False, 0)

        save_btn = Gtk.Button(label="💾 Save")
        save_btn.get_style_context().add_class("detail-save-btn")
        save_btn.connect("clicked", self._on_edit_save)
        btn_row.pack_end(save_btn, False, False, 0)

        self._content.show_all()

    def _rebuild_links_list(self) -> None:
        for child in self._links_box.get_children():
            self._links_box.remove(child)

        for idx, lnk in enumerate(self._edit_links):
            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
            icon, title = _link_icon_and_label(lnk)
            lbl = Gtk.Label(label=f"{icon} {title}")
            lbl.set_xalign(0)
            lbl.set_ellipsize(Pango.EllipsizeMode.END)
            lbl.set_max_width_chars(50)
            lbl.set_tooltip_text(lnk.get("url", lnk.get("text", "")))
            row.pack_start(lbl, True, True, 0)

            edit_btn = Gtk.Button(label="✏️")
            edit_btn.set_relief(Gtk.ReliefStyle.NONE)
            edit_btn.set_tooltip_text("Edit this link")
            edit_btn.connect("clicked", self._on_edit_link, idx)
            row.pack_start(edit_btn, False, False, 0)

            del_btn = Gtk.Button(label="✕")
            del_btn.get_style_context().add_class("detail-delete-link")
            del_btn.set_relief(Gtk.ReliefStyle.NONE)
            del_btn.set_tooltip_text("Remove this link")
            del_btn.connect("clicked", self._on_remove_link, idx)
            row.pack_start(del_btn, False, False, 0)

            self._links_box.pack_start(row, False, False, 0)

        if not self._edit_links:
            self._links_box.pack_start(
                Gtk.Label(label="No links.", xalign=0), False, False, 0
            )

        self._links_box.show_all()

    def _on_pick_appear_cal(self, _widget) -> None:
        popover = Gtk.Popover()
        popover.set_relative_to(_widget)
        cal = Gtk.Calendar()
        current = self._edit_appear.get_text().strip()
        if current:
            try:
                dt = datetime.strptime(current, "%Y-%m-%d")
                cal.select_month(dt.month - 1, dt.year)
                cal.select_day(dt.day)
            except ValueError:
                pass

        def on_day_selected(_cal):
            year, month, day = cal.get_date()
            self._edit_appear.set_text(f"{year:04d}-{month + 1:02d}-{day:02d}")
            popover.popdown()

        cal.connect("day-selected-double-click", on_day_selected)
        popover.add(cal)
        popover.show_all()

    def _on_edit_add_link(self, _widget) -> None:
        result = self._link_entry_dialog("Add Link / Reference", "", "")
        if result:
            value, title = result
            if value:
                is_url = value.startswith("http://") or value.startswith("https://")
                if is_url:
                    if not title:
                        title = fetch_page_title(value)
                    self._edit_links.append(
                        {"type": "url", "url": value, "title": title}
                    )
                else:
                    self._edit_links.append({"type": "ref", "text": value})
                self._rebuild_links_list()

    def _on_edit_link(self, _widget, idx: int) -> None:
        lnk = self._edit_links[idx]
        if lnk["type"] == "url":
            pre_value = lnk.get("url", "")
            pre_title = lnk.get("title", "")
        else:
            pre_value = lnk.get("text", "")
            pre_title = ""

        result = self._link_entry_dialog("Edit Link / Reference", pre_value, pre_title)
        if result:
            value, title = result
            if value:
                is_url = value.startswith("http://") or value.startswith("https://")
                if is_url:
                    if not title:
                        title = fetch_page_title(value)
                    self._edit_links[idx] = {
                        "type": "url",
                        "url": value,
                        "title": title,
                    }
                else:
                    self._edit_links[idx] = {"type": "ref", "text": value}
                self._rebuild_links_list()

    def _on_remove_link(self, _widget, idx: int) -> None:
        del self._edit_links[idx]
        self._rebuild_links_list()

    def _link_entry_dialog(
        self, title: str, pre_value: str, pre_title: str
    ) -> tuple | None:
        dialog = Gtk.Dialog(title=title, transient_for=self, modal=True)
        dialog.add_buttons(
            Gtk.STOCK_CANCEL,
            Gtk.ResponseType.CANCEL,
            Gtk.STOCK_OK,
            Gtk.ResponseType.OK,
        )
        dialog.set_default_size(420, -1)
        dialog.set_default_response(Gtk.ResponseType.OK)

        content = dialog.get_content_area()
        content.set_spacing(8)
        content.set_border_width(12)

        hint_lbl = Gtk.Label()
        hint_lbl.set_markup(
            '<span foreground="#888888">Paste a URL (http…) to add a web link, '
            "or any text for a clipboard reference.</span>"
        )
        hint_lbl.set_xalign(0)
        hint_lbl.set_line_wrap(True)
        content.pack_start(hint_lbl, False, False, 0)

        value_entry = Gtk.Entry()
        value_entry.set_placeholder_text("https://… or text reference")
        value_entry.set_text(pre_value)
        value_entry.set_activates_default(True)
        content.pack_start(value_entry, False, False, 0)

        title_entry = Gtk.Entry()
        title_entry.set_placeholder_text("Display title (for URLs only, optional)")
        title_entry.set_text(pre_title)
        title_entry.set_activates_default(True)
        content.pack_start(title_entry, False, False, 0)

        dialog.show_all()
        response = dialog.run()
        result = None
        if response == Gtk.ResponseType.OK:
            result = (value_entry.get_text().strip(), title_entry.get_text().strip())
        dialog.destroy()
        return result

    def _on_edit_save(self, _widget) -> None:
        note = self._load_note()
        if not note:
            self.destroy()
            return

        note["summary"] = self._edit_summary.get_text().strip() or note["summary"]

        start = self._edit_details_buf.get_start_iter()
        end = self._edit_details_buf.get_end_iter()
        note["details"] = self._edit_details_buf.get_text(start, end, False).strip()

        note["importance"] = IMPORTANCE_VALUES[self._edit_imp.get_active()]
        note["urgency"] = URGENCY_VALUES[self._edit_urg.get_active()]

        appear_spec = self._edit_appear.get_text().strip()
        recur_spec = self._edit_recur.get_text().strip()

        if appear_spec:
            note["appear_date"] = appear_spec
            note["status"] = "scheduled"
        else:
            if note.get("status") == "scheduled":
                note["status"] = "pending"
            note["appear_date"] = None

        if recur_spec:
            recur = parse_recur(recur_spec)
            if recur:
                note["recur"] = recur
                first = appear_spec or note.get("first_due")
                if not first:
                    first = datetime.now(timezone.utc).strftime("%Y-%m-%d")
                note["first_due"] = first
                if not note.get("next_due"):
                    note["next_due"] = f"{first}T00:00:00Z"
        else:
            note.pop("recur", None)
            note.pop("next_due", None)
            note.pop("first_due", None)

        note["links"] = self._edit_links

        self._save_note(note)
        self._editing = False
        self._build_view(note)

        if self.get_transient_for():
            self.get_transient_for().refresh()

    def _on_edit_cancel(self, _widget) -> None:
        note = self._load_note()
        if note:
            self._editing = False
            self._build_view(note)
        else:
            self.destroy()


# ── GTK Window ────────────────────────────────────────────────────────────────


class HotNoteWindow(Gtk.Window):
    def __init__(self):
        super().__init__(title="HotNote 🔥")
        self.set_default_size(720, 580)
        self.set_border_width(0)
        self.set_icon_name("hotnote")
        self.get_style_context().add_class("hotnote-window")
        self.connect("delete-event", lambda *_: self.hide() or True)

        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.add(vbox)

        # ── Header ─────────────────────────────────────────────────────────────
        header_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        header_box.get_style_context().add_class("hotnote-header")
        header_box.set_border_width(8)
        title_lbl = Gtk.Label()
        title_lbl.set_markup(
            '<span foreground="#ff6d00" size="x-large" weight="bold">🔥 HotNote</span>'
        )
        title_lbl.set_xalign(0)
        header_box.pack_start(title_lbl, True, True, 0)

        settings_btn = Gtk.Button(label="⚙️")
        settings_btn.set_relief(Gtk.ReliefStyle.NONE)
        settings_btn.set_tooltip_text("Settings")
        settings_btn.connect("clicked", self._on_settings)
        header_box.pack_end(settings_btn, False, False, 0)

        vbox.pack_start(header_box, False, False, 0)

        # ── Add form ──────────────────────────────────────────────────────────
        add_bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        add_bar.get_style_context().add_class("hotnote-add-bar")
        add_bar.set_border_width(10)
        vbox.pack_start(add_bar, False, False, 0)

        self.entry = Gtk.Entry()
        self.entry.set_placeholder_text("New hotnote…")
        self.entry.set_hexpand(True)
        self.entry.connect("activate", self._on_add)
        add_bar.pack_start(self.entry, True, True, 0)

        self.imp_combo = Gtk.ComboBoxText()
        for v in IMPORTANCE_VALUES:
