    # ── Actions ───────────────────────────────────────────────────────────────

    def _on_pick_date(self, _widget, entry: Gtk.Entry) -> None:
        popover = Gtk.Popover()
        popover.set_relative_to(_widget)
        cal = Gtk.Calendar()
        current = entry.get_text().strip()
        if current:
            try:
                dt = datetime.strptime(current, "%Y-%m-%d")
                cal.select_month(dt.month - 1, dt.year)
                cal.select_day(dt.day)
            except ValueError:
                pass

        def on_day_selected(_cal):
            year, month, day = cal.get_date()
            entry.set_text(f"{year:04d}-{month + 1:02d}-{day:02d}")
            popover.popdown()

        cal.connect("day-selected-double-click", on_day_selected)
        popover.add(cal)
        popover.show_all()

    def _on_schedule_toggled(self, _widget) -> None:
        if self.schedule_toggle.get_active():
            self.schedule_row.set_no_show_all(False)
            self.schedule_row.show_all()
            if not self.appear_entry.get_text().strip():
                self.appear_entry.set_text(
                    datetime.now(timezone.utc).strftime("%Y-%m-%d")
                )
        else:
            self.schedule_row.set_no_show_all(True)
            self.schedule_row.hide()
            self.appear_entry.set_text("")
            self.recur_entry.set_text("")

    def _on_activate_now(self, _widget, note_id: str) -> None:
        notes = load_notes()
        for t in notes:
            if t["id"] == note_id:
                t["status"] = "pending"
                t["appear_date"] = None
                t["completed"] = None
        save_notes(notes)
        self.refresh()

    def _on_settings(self, _widget) -> None:
        dlg = Gtk.Dialog(
            title="HotNote Settings",
            transient_for=self,
            modal=True,
            destroy_with_parent=True,
        )
        dlg.add_buttons(Gtk.STOCK_CLOSE, Gtk.ResponseType.CLOSE)
        dlg.set_default_size(480, 360)
        dlg.get_style_context().add_class("hotnote-window")

        content = dlg.get_content_area()
        content.set_spacing(8)
        content.set_border_width(12)

        title_lbl = Gtk.Label()
        title_lbl.set_markup(
            '<span foreground="#ff6d00" weight="bold">Useless Title Patterns</span>'
        )
        title_lbl.set_xalign(0)
        content.pack_start(title_lbl, False, False, 0)

        hint_lbl = Gtk.Label()
        hint_lbl.set_markup(
            '<span foreground="#888888">Regex patterns (case-insensitive). '
            "Fetched page titles matching any pattern will be discarded in favour of the domain name.</span>"
        )
        hint_lbl.set_xalign(0)
        hint_lbl.set_line_wrap(True)
        content.pack_start(hint_lbl, False, False, 0)

        cfg = load_config()
        patterns = list(cfg.get("useless_title_patterns", []))

        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroll.set_vexpand(True)
        content.pack_start(scroll, True, True, 0)

        list_box = Gtk.ListBox()
        list_box.set_selection_mode(Gtk.SelectionMode.NONE)
        scroll.add(list_box)

        def rebuild():
            for child in list_box.get_children():
                list_box.remove(child)
            for idx, pat in enumerate(patterns):
                row = Gtk.ListBoxRow()
                row.set_selectable(False)
                hbox = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
                hbox.set_border_width(4)
                lbl = Gtk.Label(label=pat)
                lbl.set_xalign(0)
                lbl.set_hexpand(True)
                lbl.set_selectable(True)
                hbox.pack_start(lbl, True, True, 0)
                del_btn = Gtk.Button(label="✕")
                del_btn.set_relief(Gtk.ReliefStyle.NONE)
                del_btn.set_tooltip_text("Remove this pattern")
                del_btn.connect("clicked", lambda _b, i=idx: on_remove(i))
                hbox.pack_end(del_btn, False, False, 0)
                row.add(hbox)
                list_box.add(row)
            list_box.show_all()

        def on_remove(idx):
            del patterns[idx]
            cfg["useless_title_patterns"] = patterns
            save_config(cfg)
            rebuild()

        rebuild()

        add_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        content.pack_start(add_box, False, False, 0)

        add_entry = Gtk.Entry()
        add_entry.set_placeholder_text("New regex pattern, e.g. .*captcha.*")
        add_entry.set_hexpand(True)
        add_box.pack_start(add_entry, True, True, 0)

        def on_add(_widget=None):
            text = add_entry.get_text().strip()
            if not text:
                return
            try:
                re.compile(text)
            except re.error as e:
                err_dlg = Gtk.MessageDialog(
                    transient_for=dlg,
                    modal=True,
                    message_type=Gtk.MessageType.ERROR,
                    buttons=Gtk.ButtonsType.OK,
                    text=f"Invalid regex: {e}",
                )
                err_dlg.run()
                err_dlg.destroy()
                return
            patterns.append(text)
            cfg["useless_title_patterns"] = patterns
            save_config(cfg)
            add_entry.set_text("")
            rebuild()

        add_entry.connect("activate", on_add)

        add_btn = Gtk.Button(label="+ Add")
        add_btn.connect("clicked", on_add)
        add_box.pack_end(add_btn, False, False, 0)

        dlg.show_all()
        dlg.run()
        dlg.destroy()

    def _on_open_detail(self, _widget, note_id: str) -> None:
        dlg = DetailDialog(self, note_id)
        dlg.connect("destroy", lambda _d: self.refresh())
        dlg.show_all()

    def _on_add(self, _widget) -> None:
        text = self.entry.get_text().strip()
        if not text:
            return
        imp = IMPORTANCE_VALUES[self.imp_combo.get_active()]
        urg = URGENCY_VALUES[self.urg_combo.get_active()]
        notes = load_notes()
        uid = new_id(notes)
        initial_status = "pending"
        appear_date = None
        recur = None

        if self.schedule_toggle.get_active():
            appear_spec = self.appear_entry.get_text().strip()
            appear_date = parse_appear_date(appear_spec) if appear_spec else None
            if appear_date:
                initial_status = "scheduled"
            recur_spec = self.recur_entry.get_text().strip()
            recur = parse_recur(recur_spec) if recur_spec else None

        note = {
            "id": uid,
            "summary": text,
            "details": "",
            "status": initial_status,
            "importance": imp,
            "urgency": urg,
            "created": now_iso(),
            "completed": None,
            "appear_date": appear_date,
            "links": [],
        }
        if recur:
            note["recur"] = recur
            first = appear_date or datetime.now(timezone.utc).strftime("%Y-%m-%d")
            note["first_due"] = first
            note["next_due"] = f"{first}T00:00:00Z"
            if not appear_date:
                note["status"] = "pending"
        notes.append(note)
        save_notes(notes)
        self.entry.set_text("")
        self.schedule_toggle.set_active(False)
        self.refresh()

    def _on_done(self, _widget, note_id: str) -> None:
        notes = load_notes()
        for t in notes:
            if t["id"] == note_id:
                t["completed"] = now_iso()
                if t.get("recur") and t.get("next_due"):
                    t["next_due"] = advance_next_due(t["next_due"], t["recur"])
                    t["status"] = "scheduled"
                    t["appear_date"] = t["next_due"][:10]
                else:
                    t["status"] = "done"
        save_notes(notes)
        self.refresh()

    def _on_reopen(self, _widget, note_id: str) -> None:
        notes = load_notes()
        for t in notes:
            if t["id"] == note_id:
                t["status"] = "pending"
                t["completed"] = None
        save_notes(notes)
        self.refresh()

    def _on_add_link(self, _widget, note_id: str) -> None:
        dialog = Gtk.Dialog(
            title="Add Link / Reference",
            transient_for=self,
            modal=True,
            destroy_with_parent=True,
        )
        dialog.add_buttons(
            Gtk.STOCK_CANCEL,
            Gtk.ResponseType.CANCEL,
            Gtk.STOCK_OK,
            Gtk.ResponseType.OK,
        )
        dialog.set_default_size(450, -1)
        dialog.set_default_response(Gtk.ResponseType.OK)

        content = dialog.get_content_area()
        content.set_spacing(8)
        content.set_border_width(12)

        hint_lbl = Gtk.Label()
        hint_lbl.set_markup(
            '<span foreground="#888888">Paste a URL (http…) to add a web link, '
            "or any text to add a reference that copies to clipboard when clicked.</span>"
        )
        hint_lbl.set_xalign(0)
        hint_lbl.set_line_wrap(True)
        content.pack_start(hint_lbl, False, False, 0)

        value_entry = Gtk.Entry()
        value_entry.set_placeholder_text("https://… or text reference")
        value_entry.set_activates_default(True)
        content.pack_start(value_entry, False, False, 0)

        title_entry = Gtk.Entry()
        title_entry.set_placeholder_text("Display title (for URLs only, optional)")
        title_entry.set_activates_default(True)
        content.pack_start(title_entry, False, False, 0)

        dialog.show_all()
        response = dialog.run()

        if response == Gtk.ResponseType.OK:
            value = value_entry.get_text().strip()
            title = title_entry.get_text().strip()

            if value:
                is_url = value.startswith("http://") or value.startswith("https://")
                notes = load_notes()
                for t in notes:
                    if t["id"] == note_id:
                        if is_url:
                            if not title:
                                title = fetch_page_title(value)
                            t.setdefault("links", []).append(
                                {
                                    "type": "url",
                                    "url": value,
                                    "title": title,
                                }
                            )
                        else:
                            t.setdefault("links", []).append(
                                {
                                    "type": "ref",
                                    "text": value,
                                }
                            )
                        break
                save_notes(notes)
                self.refresh()

        dialog.destroy()

    def _on_delete(self, _widget, note_id: str) -> None:
        notes = load_notes()
        notes = [t for t in notes if t["id"] != note_id]
        save_notes(notes)
        self.refresh()

    def refresh(self) -> None:
        for child in self.pending_list_box.get_children():
            self.pending_list_box.remove(child)
        for child in self.scheduled_list_box.get_children():
            self.scheduled_list_box.remove(child)
        for child in self.done_list_box.get_children():
            self.done_list_box.remove(child)

        notes = load_notes()
        if scheduled_activate(notes):
            save_notes(notes)
        for note in pending(notes):
            self.pending_list_box.add(self._make_pending_row(note))
        for note in scheduled(notes):
            self.scheduled_list_box.add(self._make_scheduled_row(note))
        for note in completed(notes):
            self.done_list_box.add(self._make_done_row(note))

        self.pending_list_box.show_all()
        self.scheduled_list_box.show_all()
        self.done_list_box.show_all()


# ── AppIndicator ──────────────────────────────────────────────────────────────


class HotNoteIndicator:
    def __init__(self):
        self.indicator = AppIndicator3.Indicator.new(
            "hotnote-indicator",
            ICON_NAME,
            AppIndicator3.IndicatorCategory.APPLICATION_STATUS,
        )
        self.indicator.set_icon_theme_path(ICON_DIR)
        self.indicator.set_status(AppIndicator3.IndicatorStatus.ACTIVE)

        self._last_mtime = 0.0
        self._self_mtime = _safe_mtime(SELF_PATH)
        self._window: HotNoteWindow | None = None
        self._menu = Gtk.Menu()
        self.indicator.set_menu(self._menu)

        self._rebuild_menu()
        GLib.timeout_add(2000, self._poll)

    def _poll(self) -> bool:
        new_self_mtime = _safe_mtime(SELF_PATH)
        if new_self_mtime != self._self_mtime:
            self._self_mtime = new_self_mtime
            self._reexec()
            return False

        try:
            mtime = os.path.getmtime(HOTNOTES_PATH)
        except OSError:
            return True

        notes = load_notes()
        if scheduled_activate(notes):
            save_notes(notes)
            mtime = os.path.getmtime(HOTNOTES_PATH)

        if mtime != self._last_mtime:
            self._last_mtime = mtime
            self._rebuild_menu()
            if self._window and self._window.get_visible():
                self._window.refresh()
        return True

    def _reexec(self) -> None:
        _show_notification("HotNote", "Reloading after code change…")
        argv = [sys.executable, SELF_PATH] + sys.argv[1:]
        os.execv(sys.executable, argv)

    def _rebuild_menu(self) -> None:
        for child in self._menu.get_children():
            self._menu.remove(child)

        notes = load_notes()
        items = pending(notes)

        if items:
            for note in items:
                imp = note.get("importance", "medium")
                urg = note.get("urgency", "soon")
                summary = note["summary"]
                if len(summary) > MENU_MAX_CHARS:
                    summary = summary[: MENU_MAX_CHARS - 1] + "…"
                summary = summary.ljust(MENU_MAX_CHARS)
                imp_icon = IMPORTANCE_ICON.get(imp, "")
                urg_icon = URGENCY_ICON.get(urg, "")
                recur_icon = "↻" if note.get("recur") else ""
                label = f"{summary} {imp_icon}{urg_icon}{recur_icon}"
                item = Gtk.MenuItem(label=label)
                first_link = next(
                    (l for l in note.get("links", []) if l["type"] in ("ref", "url")),
                    None,
                )
                if first_link:
                    item.connect("activate", self._on_activate_link, first_link)
                else:
                    item.set_sensitive(False)
                self._menu.append(item)
        else:
            empty = Gtk.MenuItem(label="No pending hotnotes")
            empty.set_sensitive(False)
            self._menu.append(empty)

        self._menu.append(Gtk.SeparatorMenuItem())

        open_item = Gtk.MenuItem(label="🔥 Open HotNote")
        open_item.connect("activate", self._on_open)
        self._menu.append(open_item)

        quit_item = Gtk.MenuItem(label="Quit")
        quit_item.connect("activate", self._on_quit)
        self._menu.append(quit_item)

        self._menu.show_all()

        count = len(items)
        self.indicator.set_title(f"HotNote: {count} pending")

    def _on_activate_link(self, _item, link: dict) -> None:
        open_link(link)

    def _on_open(self, _item) -> None:
        self._show_window()

    def _show_window(self) -> None:
        if self._window is None:
            self._window = HotNoteWindow()
        self._window.refresh()
        self._window.show_all()
        self._window.present()

    def _on_quit(self, _item) -> None:
        Gtk.main_quit()


# ── Entry point ───────────────────────────────────────────────────────────────


def main() -> None:
    parser = argparse.ArgumentParser(prog="hotnote-indicator")
    parser.add_argument(
        "--open-window",
        action="store_true",
        help="Open the HotNote window (starts indicator if not running)",
    )
    args = parser.parse_args()

    indicator = HotNoteIndicator()
    if args.open_window:
        GLib.idle_add(indicator._show_window)

    Gtk.main()


if __name__ == "__main__":
    main()
