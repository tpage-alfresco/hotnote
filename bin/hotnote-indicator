        self.schedule_row.pack_start(sched_cal_btn, False, False, 0)

        self.schedule_row.pack_start(
            Gtk.Label(label="Repeat every:"), False, False, 8
        )
        self.recur_entry = Gtk.Entry()
        self.recur_entry.set_placeholder_text("optional, e.g. 18d, 2w")
