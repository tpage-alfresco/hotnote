#!/usr/bin/env python3
"""HotNote CLI — read/write ~/.local/share/hotnote/hotnotes.json"""

import argparse
import json
import os
import random
import re
import subprocess
import sys
from datetime import datetime, timedelta, timezone

HOTNOTES_PATH = os.path.expanduser("~/.local/share/hotnote/hotnotes.json")
CONFIG_PATH = os.path.expanduser("~/.config/hotnote/config.json")

DEFAULT_USELESS_PATTERNS = [r".*log in.*", r".*sign in.*"]


def load_config() -> dict:
    if not os.path.exists(CONFIG_PATH):
        return {"useless_title_patterns": list(DEFAULT_USELESS_PATTERNS)}
    try:
        with open(CONFIG_PATH) as f:
            cfg = json.load(f)
        cfg.setdefault("useless_title_patterns", list(DEFAULT_USELESS_PATTERNS))
        return cfg
    except (json.JSONDecodeError, OSError):
        return {"useless_title_patterns": list(DEFAULT_USELESS_PATTERNS)}


def save_config(cfg: dict) -> None:
    os.makedirs(os.path.dirname(CONFIG_PATH), exist_ok=True)
    with open(CONFIG_PATH, "w") as f:
        json.dump(cfg, f, indent=2)
        f.write("\n")


def _is_useless_title(title: str) -> bool:
    cfg = load_config()
    lower = title.lower()
    for pattern in cfg.get("useless_title_patterns", []):
        try:
            if re.fullmatch(pattern, lower):
                return True
        except re.error:
            continue
    return False


def _domain(url: str) -> str:
    from urllib.parse import urlparse
    host = urlparse(url).hostname or url
    return host.removeprefix("www.")


def _fetch_page_title(url: str) -> str:
    """Fetch the <title> of a URL. Falls back to the domain name."""
    from urllib.request import Request, urlopen
    try:
        req = Request(url, headers={"User-Agent": "Mozilla/5.0 (HotNote)"})
        with urlopen(req, timeout=5) as resp:
            chunk = resp.read(65536).decode("utf-8", errors="ignore")
        match = re.search(r"<title[^>]*>(.*?)</title>", chunk, re.IGNORECASE | re.DOTALL)
        if match:
            import html
            title = html.unescape(match.group(1)).strip()
            if not _is_useless_title(title):
                return title
    except Exception:
        pass
    return _domain(url)


IMPORTANCE_VALUES = ["critical", "high", "medium", "low"]
URGENCY_VALUES = ["immediate", "soon", "whenever"]

IMPORTANCE_WEIGHT = {"critical": 0, "high": 1, "medium": 2, "low": 3}
URGENCY_WEIGHT = {"immediate": 0, "soon": 1, "whenever": 2}


def load() -> dict:
    if not os.path.exists(HOTNOTES_PATH):
        return {"hotnotes": []}
    with open(HOTNOTES_PATH) as f:
        return json.load(f)


def save(data: dict) -> None:
    os.makedirs(os.path.dirname(HOTNOTES_PATH), exist_ok=True)
    with open(HOTNOTES_PATH, "w") as f:
        json.dump(data, f, indent=2)
        f.write("\n")


def new_id(data: dict) -> str:
    existing = {t["id"] for t in data["hotnotes"]}
    while True:
        uid = f"{random.randint(0, 0xFFFFFF):06x}"
        if uid not in existing:
            return uid


def now_iso() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def find_note(data: dict, note_id: str) -> dict | None:
    for t in data["hotnotes"]:
        if t["id"] == note_id:
            return t
    return None


def sort_key(note: dict) -> tuple:
    imp = IMPORTANCE_WEIGHT.get(note.get("importance", "medium"), 99)
    urg = URGENCY_WEIGHT.get(note.get("urgency", "soon"), 99)
    return (imp + urg, urg)


# ── Recurrence helpers ────────────────────────────────────────────────────────

_RECUR_RE = re.compile(r"^(\d+)\s*([dwm])$", re.IGNORECASE)
_UNIT_MAP = {"d": "days", "w": "weeks", "m": "months"}


def parse_recur(spec: str) -> dict | None:
    """Parse '18d', '2w', '1m' into {"every": 18, "unit": "days"}. Returns None on 'none'."""
    if spec.lower() == "none":
        return None
    m = _RECUR_RE.match(spec.strip())
    if not m:
        sys.exit(f"Invalid recurrence '{spec}'. Use e.g. 18d, 2w, 1m, or 'none'.")
    return {"every": int(m.group(1)), "unit": _UNIT_MAP[m.group(2).lower()]}


def advance_next_due(prev_due: str, recur: dict) -> str:
    """Advance a next_due ISO string by one recurrence interval."""
    from dateutil.relativedelta import relativedelta
    dt = datetime.fromisoformat(prev_due.replace("Z", "+00:00"))
    unit = recur["unit"]
    every = recur["every"]
    if unit == "days":
        dt += timedelta(days=every)
    elif unit == "weeks":
        dt += timedelta(weeks=every)
    elif unit == "months":
        dt += relativedelta(months=every)
    return dt.strftime("%Y-%m-%dT%H:%M:%SZ")


def recur_resurrect(data: dict) -> bool:
    """Flip done recurring notes back to pending if next_due has passed. Returns True if any changed."""
    now = datetime.now(timezone.utc)
    changed = False
    for note in data["hotnotes"]:
        if note.get("status") != "done":
            continue
        if not note.get("recur") or not note.get("next_due"):
            continue
        due = datetime.fromisoformat(note["next_due"].replace("Z", "+00:00"))
        if due <= now:
            note["status"] = "pending"
            note["completed"] = None
            changed = True
    return changed


def fmt_recur(note: dict) -> str:
    """Format recurrence info for display."""
    recur = note.get("recur")
    if not recur:
        return ""
    every = recur["every"]
    unit = recur["unit"]
    short = {"days": "d", "weeks": "w", "months": "mo"}[unit]
    return f" ↻{every}{short}"


def fmt_note(note: dict, show_links: bool = False) -> str:
    imp = note.get("importance", "medium")
    urg = note.get("urgency", "soon")
    status = note.get("status", "pending")
    done_marker = "✓" if status == "done" else " "
    line = f"[{done_marker}] {note['id']}  {imp:<8} {urg:<9}  {note['summary']}{fmt_recur(note)}"
    if note.get("completed"):
        line += f"  (done {note['completed'][:10]})"
    if show_links and note.get("links"):
        for lnk in note["links"]:
            if lnk["type"] == "ref":
                line += f"\n         ref: {lnk.get('text', '')}"
            else:
                line += f"\n         {lnk.get('url', '')}  {lnk.get('title', '')}"
    return line


# ── Commands ──────────────────────────────────────────────────────────────────

def cmd_add(args) -> None:
    if args.importance not in IMPORTANCE_VALUES:
        sys.exit(f"Invalid importance '{args.importance}'. Choose: {', '.join(IMPORTANCE_VALUES)}")
    if args.urgency not in URGENCY_VALUES:
        sys.exit(f"Invalid urgency '{args.urgency}'. Choose: {', '.join(URGENCY_VALUES)}")
    data = load()
    uid = new_id(data)
    note = {
        "id": uid,
        "summary": args.summary,
        "details": "",
        "status": "pending",
        "importance": args.importance,
        "urgency": args.urgency,
        "created": now_iso(),
        "completed": None,
        "links": [],
    }
    if args.recur:
        recur = parse_recur(args.recur)
        if recur:
            note["recur"] = recur
            first = args.first_due or datetime.now(timezone.utc).strftime("%Y-%m-%d")
            note["first_due"] = first
            note["next_due"] = f"{first}T00:00:00Z"
    data["hotnotes"].append(note)
    save(data)
    print(uid)


def cmd_list(args) -> None:
    data = load()
    if recur_resurrect(data):
        save(data)
    notes = data["hotnotes"]
    if not args.all:
        notes = [t for t in notes if t.get("status") != "done"]
    notes = sorted(notes, key=sort_key)
    if not notes:
        print("No hotnotes." if args.all else "No pending hotnotes.")
        return
    header = f"{'':3} {'ID':<6}  {'IMPORTANCE':<8} {'URGENCY':<9}  SUMMARY"
    print(header)
    print("-" * 72)
    for t in notes:
        print(fmt_note(t, show_links=args.links))


def cmd_done(args) -> None:
    data = load()
    note = find_note(data, args.id)
    if not note:
        sys.exit(f"No hotnote with id '{args.id}'")
    note["status"] = "done"
    note["completed"] = now_iso()
    if note.get("recur") and note.get("next_due"):
        note["next_due"] = advance_next_due(note["next_due"], note["recur"])
        print(f"Marked done: {note['summary']} (next due {note['next_due'][:10]})")
    else:
        print(f"Marked done: {note['summary']}")
    save(data)


def cmd_reopen(args) -> None:
    data = load()
    note = find_note(data, args.id)
    if not note:
        sys.exit(f"No hotnote with id '{args.id}'")
    note["status"] = "pending"
    note["completed"] = None
    save(data)
    print(f"Reopened: {note['summary']}")


def cmd_delete(args) -> None:
    data = load()
    before = len(data["hotnotes"])
    data["hotnotes"] = [t for t in data["hotnotes"] if t["id"] != args.id]
    if len(data["hotnotes"]) == before:
        sys.exit(f"No hotnote with id '{args.id}'")
    save(data)
    print(f"Deleted {args.id}")


def cmd_set(args) -> None:
    data = load()
    note = find_note(data, args.id)
    if not note:
        sys.exit(f"No hotnote with id '{args.id}'")
    if args.importance:
        if args.importance not in IMPORTANCE_VALUES:
            sys.exit(f"Invalid importance. Choose: {', '.join(IMPORTANCE_VALUES)}")
        note["importance"] = args.importance
    if args.urgency:
        if args.urgency not in URGENCY_VALUES:
            sys.exit(f"Invalid urgency. Choose: {', '.join(URGENCY_VALUES)}")
        note["urgency"] = args.urgency
    if args.summary:
        note["summary"] = args.summary
    if args.details is not None:
        note["details"] = args.details
    if args.recur:
        recur = parse_recur(args.recur)
        if recur:
            note["recur"] = recur
            if args.first_due:
                note["first_due"] = args.first_due
                note["next_due"] = f"{args.first_due}T00:00:00Z"
            elif not note.get("next_due"):
                first = datetime.now(timezone.utc).strftime("%Y-%m-%d")
                note["first_due"] = first
                note["next_due"] = f"{first}T00:00:00Z"
        else:
            note.pop("recur", None)
            note.pop("next_due", None)
            note.pop("first_due", None)
    save(data)
    print(f"Updated {args.id}")


def cmd_link(args) -> None:
    data = load()
    note = find_note(data, args.id)
    if not note:
        sys.exit(f"No hotnote with id '{args.id}'")

    raw = args.ref
    title = args.title or ""

    is_url = raw.startswith("http://") or raw.startswith("https://")

    if is_url:
        if not title:
            title = _fetch_page_title(raw)
        link = {"type": "url", "url": raw, "title": title}
    else:
        link = {"type": "ref", "text": raw}

    note.setdefault("links", []).append(link)
    save(data)
    kind = "URL" if is_url else "reference"
    print(f"Linked {kind} to {args.id}")


def cmd_show(args) -> None:
    data = load()
    note = find_note(data, args.id)
    if not note:
        sys.exit(f"No hotnote with id '{args.id}'")
    print(json.dumps(note, indent=2))


def cmd_open(_args) -> None:
    indicator_bin = os.path.expanduser("~/.local/bin/hotnote-indicator")
    subprocess.Popen(
        [indicator_bin, "--open-window"],
        start_new_session=True,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


# ── Argument parser ───────────────────────────────────────────────────────────

def main() -> None:
    parser = argparse.ArgumentParser(
        prog="hotnote",
        description="HotNote — manage your hotnotes",
    )
    sub = parser.add_subparsers(dest="command", required=True)

    p_add = sub.add_parser("add", help="Add a new hotnote")
    p_add.add_argument("summary")
    p_add.add_argument("--importance", default="medium", choices=IMPORTANCE_VALUES)
    p_add.add_argument("--urgency", default="soon", choices=URGENCY_VALUES)
    p_add.add_argument("--recur", help="Recurrence interval: e.g. 18d, 2w, 1m")
    p_add.add_argument("--first-due", help="First due date (YYYY-MM-DD, defaults to today)")
    p_add.set_defaults(func=cmd_add)

    p_list = sub.add_parser("list", help="List hotnotes")
    p_list.add_argument("--all", action="store_true", help="Include completed")
    p_list.add_argument("--links", action="store_true", help="Show linked references")
    p_list.set_defaults(func=cmd_list)

    p_done = sub.add_parser("done", help="Mark a hotnote as completed")
    p_done.add_argument("id")
    p_done.set_defaults(func=cmd_done)

    p_reopen = sub.add_parser("reopen", help="Reopen a completed hotnote")
    p_reopen.add_argument("id")
    p_reopen.set_defaults(func=cmd_reopen)

    p_del = sub.add_parser("delete", help="Delete a hotnote")
    p_del.add_argument("id")
    p_del.set_defaults(func=cmd_delete)

    p_set = sub.add_parser("set", help="Update a hotnote's fields")
    p_set.add_argument("id")
    p_set.add_argument("--importance", choices=IMPORTANCE_VALUES)
    p_set.add_argument("--urgency", choices=URGENCY_VALUES)
    p_set.add_argument("--summary")
    p_set.add_argument("--details", help="Set the details/notes text")
    p_set.add_argument("--recur", help="Recurrence: e.g. 18d, 2w, 1m, or 'none' to remove")
    p_set.add_argument("--first-due", help="First due date (YYYY-MM-DD)")
    p_set.set_defaults(func=cmd_set)

    p_link = sub.add_parser("link", help="Attach a link or text reference to a hotnote")
    p_link.add_argument("id")
    p_link.add_argument("ref", help="URL (https://...) or text reference")
    p_link.add_argument("title", nargs="?", default="", help="Optional display title")
    p_link.set_defaults(func=cmd_link)

    p_show = sub.add_parser("show", help="Show full detail for a hotnote")
    p_show.add_argument("id")
    p_show.set_defaults(func=cmd_show)

    p_open = sub.add_parser("open", help="Open the HotNote window")
    p_open.set_defaults(func=cmd_open)

    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
