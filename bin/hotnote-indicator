            vbox.pack_start(link_flow, False, False, 0)
            for lnk in links:
                link_flow.add(_make_link_button(lnk))

        outer.pack_start(
            Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL), False, False, 0
        )
        return row

