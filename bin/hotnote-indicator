        self.schedule_row.set_border_width(4)
        self.schedule_row.set_margin_start(10)
        self.schedule_row.set_margin_end(10)
        vbox.pack_start(self.schedule_row, False, False, 0)

        self.schedule_row.pack_start(
            Gtk.Label(label="Appear on:"), False, False, 0
        )
        self.appear_entry = Gtk.Entry()
        self.appear_entry.set_placeholder_text("YYYY-MM-DD")
        self.appear_entry.set_width_chars(12)
